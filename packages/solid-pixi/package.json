{
  "name": "solid-pixi",
  "version": "3.0.0",
  "description": "Build Pixi.js scenes with Solid JSX and signals",
  "keywords": [
    "canvas",
    "jsx",
    "pixi",
    "pixi.js",
    "renderer",
    "solid",
    "solid-js",
    "webgl"
  ],
  "homepage": "https://sammccord.github.io/solid-pixi",
  "bugs": {
    "url": "https://github.com/sammccord/solid-pixi/issues"
  },
  "license": "MIT",
  "author": "Sam McCord <sam.mccord@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammccord/solid-pixi.git",
    "directory": "packages/solid-pixi"
  },
  "files": [
    "dist",
    "src",
    "types"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp build && tsc",
    "prepublishOnly": "rm -rf dist && pnpm run build"
  },
  "dependencies": {
    "@solidjs/universal": "^2.0.0-rc.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.34",
    "pixi.js": "^8.7.3",
    "solid-js": "^2.0.0-rc.3",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "pixi.js": "^8.7.0",
    "solid-js": "^2.0.0-rc.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
