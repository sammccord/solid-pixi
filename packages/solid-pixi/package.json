{
  "name": "solid-pixi",
  "version": "3.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammccord/solid-pixi.git"
  },
  "author": "Sam McCord <sam.mccord@protonmail.com>",
  "bugs": {
    "url": "https://github.com/sammccord/solid-pixi/issues"
  },
  "homepage": "https://sammccord.github.io/solid-pixi",
  "license": "MIT",
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/solid-pixi.umd.js",
  "module": "./dist/solid-pixi.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/solid-pixi.mjs",
      "require": "./dist/solid-pixi.umd.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "default": "./dist/solid-pixi.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "default": "./dist/solid-pixi.mjs"
    }
  },
  "scripts": {
    "prepublishOnly": "rm -rf dist && npm run build",
    "build": "vp build && tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "pixi.js": "^8.7.0",
    "solid-js": "^2.0.0-rc.3"
  },
  "dependencies": {
    "@solidjs/universal": "^2.0.0-rc.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.34",
    "pixi.js": "^8.7.3",
    "solid-js": "^2.0.0-rc.3"
  }
}
