{
  "name": "solid-pixi-repo",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammccord/solid-pixi.git"
  },
  "author": "Sam McCord <sam.mccord@protonmail.com>",
  "bugs": {
    "url": "https://github.com/sammccord/solid-pixi/issues"
  },
  "homepage": "https://sammccord.github.io/solid-pixi",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "changeset:release": "turbo run build && changeset publish",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "publish-packages": "pnpm changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.12",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jsdom": "^20.0.3",
    "lefthook": "^1.10.10",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.3.1",
    "solid-js": "^2.0.0-rc.3",
    "turbo": "^1.13.4",
    "typescript": "^5.7.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "pretty-quick --write"
    ],
    "*.{json,md}": [
      "pretty-quick --write"
    ]
  },
  "config": {
    "unsafe-perm": true,
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
